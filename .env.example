# ---------------------------------------------------------------------------
# Obsidian 3D Portfolio — environment variables
# Copy this file to `.env.local` and fill in the values you want to use.
# Every variable below is OPTIONAL: the site runs fully without them.
# ---------------------------------------------------------------------------

# --- Contact form (server-side only, never exposed to the browser) ----------
# Option A: Resend (https://resend.com) — recommended.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=you@yourdomain.com
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
#
# Option B: any webhook that accepts a JSON POST (Discord, Slack, Make, n8n…).
# CONTACT_WEBHOOK_URL=https://example.com/webhook
#
# Optional: full public site URL, used for canonical URLs, sitemap and OG tags.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
